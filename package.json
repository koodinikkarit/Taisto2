{
	"name": "taisto",
	"version": "0.1.4",
	"description": "Taisto",
	"main": "server.js",
	"author": {
		"name": "Jaska"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"start": "cross-env NODE_ENV=production babel-node app.js -- -p 1337",
		"app": "cross-env NODE_ENV=production babel-node app.js",
		"build": "webpack --mode production",
		"dev": "cross-env NODE_ENV=development babel-node app.js -- -d -p 1337",
		"watch": "cross-env NODE_ENV=development nodemon --watch backend --watch js --watch app.js --exec \"babel-node app.js -- -d -p 1337\"",
		"testmatrix": "babel-node ./tests/MatrixTest.js"
	},
	"dependencies": {
		"@babel/runtime": "^7.24.7",
		"apollo-client": "^0.10.1",
		"apollo-local-query": "^0.3.0",
		"body-parser": "1.15.2",
		"express": "^4.19.2",
		"express-graphql": "0.5.3",
		"graphql": "0.6.2",
		"graphql-sequelize": "3.0.0-0",
		"graphql-tag": "^1.2.1",
		"immutable": "^3.8.1",
		"node-schedule": "1.2.0",
		"react": "^15.3.1",
		"react-apollo": "^0.8.1",
		"react-bootstrap": "*",
		"react-dom": "^15.3.1",
		"react-measure": "1.4.5",
		"react-redux": "5.0.1",
		"react-router": "2.7.0",
		"redux": "^3.6.0",
		"redux-logger": "2.7.4",
		"redux-thunk": "2.1.0",
		"socket.io": "^1.7.2"
	},
	"devDependencies": {
		"@babel/cli": "^7.24.7",
		"@babel/core": "^7.24.7",
		"@babel/node": "^7.24.7",
		"@babel/plugin-transform-runtime": "^7.24.7",
		"@babel/preset-env": "^7.24.7",
		"@babel/preset-react": "^7.24.7",
		"babel-loader": "^9.1.3",
		"cross-env": "^7.0.3",
		"nodemon": "^3.1.0",
		"prettier": "^1.11.1",
		"webpack": "^5.91.0",
		"webpack-cli": "^5.1.4",
		"webpack-dev-middleware": "^5.3.3"
	}
}
