{
	"name": "taisto",
	"version": "0.1.9",
	"description": "Taisto",
	"main": "app.js",
	"author": {
		"name": "Jaska"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"start": "cross-env NODE_ENV=production babel-node app.js -- -p 1337",
		"app": "cross-env NODE_ENV=production babel-node app.js",
		"build": "webpack --mode production",
		"dev": "cross-env NODE_ENV=development babel-node app.js -- -d -p 1337",
		"watch": "cross-env NODE_ENV=development nodemon --watch backend --watch js --watch app.js --exec \"babel-node app.js -- -d -p 1337\"",
		"testmatrix": "babel-node ./tests/MatrixTest.js"
	},
	"dependencies": {
		"@apollo/client": "^3.14.1",
		"@babel/runtime": "^7.24.7",
		"express": "^4.19.2",
		"graphql": "^16.14.2",
		"graphql-http": "^1.23.0",
		"graphql-tag": "^2.12.7",
		"history": "^4.10.1",
		"immutable": "^5.1.9",
		"node-schedule": "1.2.0",
		"react": "^18.3.1",
		"react-bootstrap": "*",
		"react-dom": "^18.3.1",
		"react-redux": "^7.2.9",
		"react-router-dom": "^5.3.4",
		"redux": "^4.2.1",
		"redux-logger": "^3.0.6",
		"redux-thunk": "^2.4.2",
		"socket.io": "^4.8.3"
	},
	"devDependencies": {
		"@babel/cli": "^7.24.7",
		"@babel/core": "^7.24.7",
		"@babel/node": "^7.24.7",
		"@babel/plugin-transform-runtime": "^7.24.7",
		"@babel/preset-env": "^7.24.7",
		"@babel/preset-react": "^7.24.7",
		"babel-loader": "^9.1.3",
		"cross-env": "^7.0.3",
		"nodemon": "^3.1.0",
		"prettier": "^1.11.1",
		"webpack": "^5.91.0",
		"webpack-cli": "^5.1.4",
		"webpack-dev-middleware": "^5.3.3"
	},
	"overrides": {
		"node-fetch": "2.6.7"
	}
}
